{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swoleup-push",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "SCHEDULE", "class_name": "PushSchedule" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushSchedule"] }]
}
